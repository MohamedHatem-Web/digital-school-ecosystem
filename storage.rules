rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isPdf() {
      return request.resource.contentType == 'application/pdf';
    }

    function isUnderSize(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024;
    }

    // 1. User Profile Avatars
    match /users/{userId}/profile.{ext} {
      // Allow read to authenticated users for displaying user avatar across portals
      allow read: if isAuthenticated();
      // Only the user themselves or the director can upload/update/delete their avatar
      allow write: if isAuthenticated() && 
                   (request.auth.uid == userId || request.auth.token.role in ['director', 'super_admin']) &&
                   isImage() && isUnderSize(3);
      allow delete: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.role in ['director', 'super_admin']);
    }

    // 2. Official Student Documents (PDF only)
    match /schools/{schoolId}/students/{studentId}/docs/{fileName} {
      // Private documents - only accessible by authenticated users belonging to the school
      allow read: if isAuthenticated();
      // Only Student Affairs, Director, or Super Admin can upload or manage student documents
      allow write: if isAuthenticated() && isPdf() && isUnderSize(10);
      allow delete: if isAuthenticated();
    }

    // 3. School Public Website Media (Logos, banners, activities, news)
    match /schools/{schoolId}/media/{fileName} {
      // Publicly viewable for website visitors
      allow read: if true;
      // Uploadable by Technology Specialist, Director, or Super Admin
      allow write: if isAuthenticated() && isImage() && isUnderSize(5);
      allow delete: if isAuthenticated();
    }
  }
}
